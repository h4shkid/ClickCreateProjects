# CCSnapshotApp Environment Variables
# Copy this file to .env.local for local development
# For production, set these in Vercel dashboard

# ========================================
# DATABASE (Required)
# ========================================
# PostgreSQL connection string from Neon/Supabase
# Format: postgres://username:password@host:5432/database?sslmode=require
POSTGRES_URL=postgres://username:password@host.neon.tech/database?sslmode=require

# ========================================
# BLOCKCHAIN RPC (Required - at least one)
# ========================================
# Alchemy API Key (Recommended)
# Get from: https://www.alchemy.com/ → Create App → Ethereum Mainnet
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# QuickNode Endpoint (Alternative)
# Get from: https://www.quiknode.com/ → Create Endpoint
# NEXT_PUBLIC_QUICKNODE_ENDPOINT=https://your-endpoint.quiknode.pro/

# ========================================
# EXTERNAL APIs (Required)
# ========================================
# OpenSea API Key for collection metadata
# Get from: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your_opensea_api_key_here

# WalletConnect (Reown) Project ID
# Get from: https://cloud.reown.com/ → Create Project
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_reown_project_id_here

# ========================================
# AUTHENTICATION (Required)
# ========================================
# JWT Secret for authentication (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_random_jwt_secret_min_32_characters

# ========================================
# APPLICATION (Required for production)
# ========================================
# Production URL
NEXT_PUBLIC_APP_URL=https://snapshot.clickcreate.io

# ========================================
# NOTES
# ========================================
# - NEXT_PUBLIC_* variables are exposed to browser (safe for client-side API keys)
# - Other variables are server-only and never exposed to browser
# - Always include ?sslmode=require in POSTGRES_URL
# - Never commit .env.local to git
